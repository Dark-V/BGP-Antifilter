MY_AS=64500
PEER_AS=65455
PEER_IP=192.168.55.1
# Legacy MT_AS / MT_IP are still accepted. PEER_* wins within the same source.
BIRD_IP=192.168.55.5
ROUTER_ID=192.168.55.5
BGP_COMMUNITY=65432,500
UPDATE_INTERVAL=1800
CACHE_MAX_AGE=604800
FETCH_WORKERS=8
FETCH_TIMEOUT=30
FETCH_ATTEMPTS=5
FETCH_RETRY_DELAY=5
DNS_RESOLVERS=
DNS_RESOLVE_TIMEOUT=3
DNS_WORKERS=16
DNS_QPS=50
# Optional DNS proxy; set upstream, listener IP and client networks before enabling.
DNS_PROXY_ENABLED=0
DNS_PROXY_UPSTREAM=
DNS_PROXY_UPSTREAM_PORT=53
DNS_PROXY_BIND=127.0.0.1
DNS_PROXY_PORT=53
DNS_PROXY_ALLOWED_CLIENTS="127.0.0.1/32 ::1/128"
DNS_PROXY_HEALTH_PORT=8053
DNS_HEALTH_DOMAIN=example.org
DNS_BGP_PORT=1179
DNS_ROUTE_GRACE=30
DNS_SYNC_MODE=async
DNS_SYNC_TIMEOUT=1
DNS_SYNC_ON_TIMEOUT=servfail
INCLUDE_GOOGLE_RANGES=1
REQUIRE_ALL_URL_SOURCES=0
MIN_PREFIX_LENGTH=8
ALLOW_BROAD_ROUTES=0
UPDATE_LOCK_DIR=/etc/bird/generated/update.lock
HEALTHCHECK_REQUIRE_BGP=1
HEALTHCHECK_FAIL_ON_DEGRADED=0
# Historic session name retained for existing healthchecks and scripts.
BGP_PROTOCOL=mikrotik
ADMIN_ENABLED=0
ADMIN_PORT=8080
ADMIN_PASSWORD=
NO_ADMIN_PASSWORD=false
