BGP_ANTIFILTER_VERSION=0.4.5
MY_AS=64500
MT_AS=65455
MT_IP=192.168.55.1
BIRD_IP=192.168.55.5
ROUTER_ID=192.168.55.5
BGP_COMMUNITY=65432,500
UPDATE_INTERVAL=1800
CACHE_MAX_AGE=604800
INCLUDE_GOOGLE_RANGES=1
REQUIRE_ALL_URL_SOURCES=0
MIN_PREFIX_LENGTH=8
ALLOW_BROAD_ROUTES=0
UPDATE_LOCK_DIR=/etc/bird/generated/update.lock
HEALTHCHECK_REQUIRE_BGP=1
HEALTHCHECK_FAIL_ON_DEGRADED=0
BGP_PROTOCOL=mikrotik
ADMIN_ENABLED=0
ADMIN_PORT=8080
ADMIN_PASSWORD=

# Optional real-time DNS integration (see docs/adguard-dns.md).
# Enable both DNS_PROXY_ENABLED=1 and COMPOSE_PROFILES=dns.
DNS_PROXY_ENABLED=0
COMPOSE_PROFILES=
ADGUARD_DNS=192.168.88.16
ADGUARD_DNS_PORT=53
# DNS_PROXY_BIND defaults to BIRD_IP; it must be a local address on the host.
# DNS_PROXY_ALLOWED_CLIENTS defaults to MT_IP/32. Separate extra CIDRs by commas.
DNS_PROXY_PORT=53
DNS_PROXY_HEALTH_PORT=8053
DNS_ROUTE_GRACE=30
DNS_BGP_PORT=1179
# async: immediate DNS; bgp: wait for local send; bird: confirm local BIRD RIB.
DNS_SYNC_MODE=async
DNS_SYNC_TIMEOUT=1
# Applies to synchronization errors/overload too; forward permits a routing race.
DNS_SYNC_ON_TIMEOUT=servfail
DNS_HEALTH_DOMAIN=example.org
# With DNS enabled, set this to: bird admin dns-proxy
UPDATER_COMPOSE_SERVICES=bird admin
